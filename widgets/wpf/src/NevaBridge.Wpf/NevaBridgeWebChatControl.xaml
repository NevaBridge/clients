<UserControl x:Class="NevaBridge.Wpf.NevaBridgeWebChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#F3F5F8">
    <Grid>
        <wv2:WebView2 x:Name="WebView" />
        <TextBlock x:Name="LoadError" Visibility="Collapsed" Margin="24" TextWrapping="Wrap"
                   VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                   FontFamily="Segoe UI" FontSize="13" Foreground="#B8342A" />
    </Grid>
</UserControl>
