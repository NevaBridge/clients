<Window x:Class="NevaBridge.Sample.DesktopApp.NevaBridgeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NevaBridge settings" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
            Saved in Windows Credential Manager for your Windows user. The example uses them when
            NEVABRIDGE_SETTINGS_SOURCE is credential-manager.
        </TextBlock>

        <TextBlock Text="API key" FontWeight="SemiBold" />
        <PasswordBox x:Name="ApiKey" Margin="0,2,0,10" />

        <TextBlock Text="Product id" FontWeight="SemiBold" />
        <TextBox x:Name="ProductId" Margin="0,2,0,10" />

        <TextBlock Text="NevaBridge environment" FontWeight="SemiBold" />
        <ComboBox x:Name="Environment" Margin="0,2,0,10" SelectedIndex="0">
            <ComboBoxItem Content="Sandbox" Tag="https://tenant.api.sandbox.nevabridge.com" />
            <ComboBoxItem Content="Production" Tag="https://tenant.api.nevabridge.com" />
        </ComboBox>

        <TextBlock Text="Web chat URL (empty: the page shipped with the application)" FontWeight="SemiBold" />
        <TextBox x:Name="WebChatUrl" Margin="0,2,0,10" />

        <TextBlock x:Name="Problem" Foreground="#B8342A" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10" />

        <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Remove saved settings" Padding="10,4" Click="OnRemove" />
            <Button DockPanel.Dock="Right" Content="Cancel" Padding="14,4" Margin="8,0,0,0" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="Save" Padding="14,4" IsDefault="True" Click="OnSave" />
        </DockPanel>
    </StackPanel>
</Window>
