<Window x:Class="NevaBridge.Sample.DesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contoso Billing (NevaBridge WPF sample)" Width="1000" Height="640"
        FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="NevaBridge _settings..." Click="OnNevaBridgeSettings" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem x:Name="IntakeChatMenuItem" Header="Support _assistant..." Click="OnOpenIntakeChat" />
                <MenuItem x:Name="ClassicChatMenuItem" Header="_Report a problem..." Click="OnOpenSupport" />
                <MenuItem x:Name="WebChatMenuItem" Header="_NevaBridge chat..." Click="OnOpenNevaBridgeChat" />
            </MenuItem>
        </Menu>

        <!-- Why the support assistant is hidden: the tenant's features could not be read. -->
        <Border x:Name="FeaturesProblem" DockPanel.Dock="Top" Background="#FFF4E5" Padding="16,6" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Check again" Padding="10,3" Click="OnCheckFeaturesAgain" />
                <TextBlock x:Name="FeaturesProblemText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Stand-in for the host application's own screens. -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <!-- The NevaBridge web chat, recognizable by the NevaBridge mark alone. -->
                <Button x:Name="WebChatButton" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6" Click="OnOpenNevaBridgeChat"
                        ToolTip="NevaBridge" AutomationProperties.Name="NevaBridge support chat">
                    <Viewbox Width="22" Height="22">
                        <Canvas Width="64" Height="64">
                            <Canvas.Resources>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="#0D8579" />
                                    <Setter Property="StrokeLineJoin" Value="Round" />
                                </Style>
                            </Canvas.Resources>
                            <Path Data="M8,53 C15,39 22,33 32,33 S49,39 56,53" StrokeThickness="6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="M6,23 L16,14 M16,14 L25,31 M16,14 L32,31 M48,14 L32,31 M48,14 L39,31 M48,14 L58,23"
                                  StrokeThickness="1.5" />
                            <Path Data="M6,30 L58,30" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="M16,41 L16,11 M48,41 L48,11" StrokeThickness="5" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <!-- The native classic chat: the reporter picks the report type. -->
                <Button x:Name="ClassicChatButton" DockPanel.Dock="Right" Margin="8,0,0,0" Content="Report a problem" Padding="14,6" Click="OnOpenSupport" />
                <!-- The native Generic Intake chat: the assistant works out what the reporter needs. -->
                <Button x:Name="IntakeChatButton" DockPanel.Dock="Right" Content="Support assistant" Padding="14,6" Click="OnOpenIntakeChat" />
                <TextBlock Text="Invoices" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <DataGrid x:Name="Invoices" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="120" />
                    <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*" />
                    <DataGridTextColumn Header="Due" Binding="{Binding Due, StringFormat=d}" Width="120" />
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
